 import os
+import sys
 from contextlib import contextmanager
 
 from nuitka.__past__ import subprocess
@@ -417,9 +418,61 @@ def createProcess(
     return process
 
 
+def _executeWasiPythonProbe(command, stdin):
+    """WASI has no processes; replay target-Python probes recorded ahead of time.
+
+    Probes are keyed by the exact argument vector and stdin. Missing entries are
+    a hard error; "tools/wasi-probe-cache.py" records them with the very same
+    "python.wasm" runtime and file system layout.
+    """
+    import hashlib
+    import json
+
+    if stdin is True or stdin is False:
+        stdin = b""
+    if type(stdin) is not bytes:
+        stdin = stdin.encode("utf8")
+
+    if command[0] in ("", sys.executable):
+        command = ["<python>"] + list(command[1:])
+    command = list(command)
+
+    key = hashlib.sha256(
+        json.dumps([command, stdin.decode("utf8")]).encode("utf8")
+    ).hexdigest()
+
+    cache_filename = os.environ.get("NUITKA_WASI_PROBE_CACHE", "")
+    cache = {}
+    if cache_filename and os.path.exists(cache_filename):
+        with open(cache_filename) as cache_file:
+            cache = json.load(cache_file)
+
+    if key not in cache:
+        pending_filename = cache_filename + ".pending.json"
+        with open(pending_filename, "w") as pending_file:
+            json.dump(
+                {"key": key, "args": command, "stdin": stdin.decode("utf8")},
+                pending_file,
+            )
+        sys.exit(
+            "Nuitka-WASI: no recorded result for target Python probe %s, request written to %r"
+            % (key, pending_filename)
+        )
+
+    entry = cache[key]
+    return (
+        entry["stdout"].encode("utf8"),
+        entry["stderr"].encode("utf8"),
+        entry["exit_code"],
+    )
+
+
 def executeProcess(
     command, env=None, stdin=False, shell=False, external_cwd=False, timeout=None
 ):
+    if sys.platform == "wasi":
+        return _executeWasiPythonProbe(command, stdin)
+
     process = createProcess(
         command=command, env=env, stdin=stdin, shell=shell, external_cwd=external_cwd
     )

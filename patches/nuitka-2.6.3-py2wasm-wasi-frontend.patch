--- a/nuitka/build/SconsSpawn.py
+++ b/nuitka/build/SconsSpawn.py
@@ -382,6 +382,30 @@ def _runSpawnMonitored(env, sh, cmd, args, os_env):
     return thread.getSpawnResult()
 
 
+def _recordWasiSpawn(args):
+    """Record a build action for the browser hosted clang/lld.
+
+    WASI cannot spawn processes. The command line Scons decided on is appended
+    to the build plan "NUITKA_WASI_BUILD_PLAN" (JSON lines), and an empty
+    placeholder is created for the target so Scons dependency tracking works.
+    The host executes the plan in order and replaces every placeholder.
+    """
+    import json
+    import shlex
+
+    argv = shlex.split(" ".join(args))
+
+    with open(os.environ["NUITKA_WASI_BUILD_PLAN"], "a") as plan_file:
+        plan_file.write(json.dumps({"cwd": os.getcwd(), "argv": argv}) + "\n")
+
+    if "-o" in argv:
+        target = argv[argv.index("-o") + 1]
+        with open(target, "wb"):
+            pass
+
+    return 0
+
+
 def _getWrappedSpawnFunction(env):
     def spawnCommand(sh, escape, cmd, args, os_env):
         # signature needed towards Scons core, pylint: disable=unused-argument
@@ -392,7 +416,10 @@ def _getWrappedSpawnFunction(env):
             os_env = dict(os_env)
             os_env["CCACHE_DISABLE"] = "1"
 
-        result, exception = _runSpawnMonitored(env, sh, cmd, args, os_env)
+        if sys.platform == "wasi":
+            result, exception = _recordWasiSpawn(args), None
+        else:
+            result, exception = _runSpawnMonitored(env, sh, cmd, args, os_env)
 

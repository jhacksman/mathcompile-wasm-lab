+def _runSconsInProcess(scons_command, cwd):
+    """Run the inline Scons inside this interpreter, WASI has no processes.
+
+    The build actions are not executed here, see "SconsSpawn", they are
+    recorded into a build plan for the browser hosted clang/lld.
+    """
+    import runpy
+
+    script_index = [
+        i for i, arg in enumerate(scons_command) if arg.endswith("scons.py")
+    ][0]
+
+    old_argv, old_path, old_cwd = sys.argv, list(sys.path), os.getcwd()
+    sys.argv = scons_command[script_index:]
+    try:
+        if cwd is not None:
+            os.chdir(cwd)
+        runpy.run_path(scons_command[script_index], run_name="__main__")
+        result = 0
+    except SystemExit as e:
+        result = e.code if type(e.code) is int else (0 if e.code is None else 1)
+    finally:
+        sys.argv, sys.path[:] = old_argv, old_path
+        os.chdir(old_cwd)
+
+    return result
+
+
